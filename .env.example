# ---- Database ----
# Production: a real PostgreSQL URL, e.g. postgres://user:password@host:5432/goroitam
# Local without installing Postgres: embedded PostgreSQL (PGlite) stored in ./.data
DATABASE_URL=pglite:./.data/pg

# Public URL of the app (used in email links). Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that become admin after verifying their email.
ADMIN_EMAILS=

# ---- Email (SMTP) ----
# Required in production. In development, if SMTP_HOST is empty, emails are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gỡ Rối Tâm <no-reply@your-domain>"

# ---- Abuse protection ----
# Number of reverse proxies YOU run in front of the app (Nginx/Caddy = 1). The client IP is taken
# from the entry that proxy appends to X-Forwarded-For; anything the client sends itself is ignored.
TRUSTED_PROXY_HOPS=1
# Max new signups per hour for the whole site, and max free guest AI answers per day.
SIGNUP_HOURLY_LIMIT=60
GUEST_AI_DAILY_LIMIT=100

# Random string used to hash guest IPs (server only).
GUEST_HASH_SALT=change-me

# ---- AI ----
# mock | openai-compatible
LLM_PROVIDER=mock
# e.g. local Ollama: http://localhost:11434/v1  (or any OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional. Output token budget (default 900). Reasoning models need more, e.g. 2000.
LLM_MAX_TOKENS=
# Optional, reasoning models only (e.g. low | medium | high). Leave empty for other models.
LLM_REASONING_EFFORT=

# Shown when a message looks like a crisis. Fill with local help lines you have verified.
CRISIS_HELP_TEXT=
