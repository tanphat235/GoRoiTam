# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random string used to hash guest IPs (server only)
GUEST_HASH_SALT=change-me

# LLM: mock | openai-compatible
LLM_PROVIDER=mock
# e.g. local Ollama: http://localhost:11434/v1  (or any OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Shown when a message looks like a crisis. Fill with real local help lines you have verified.
CRISIS_HELP_TEXT=
